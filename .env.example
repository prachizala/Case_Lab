# ==============================================================================
# SBS CaseLab - Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local:
#   Windows (PowerShell): Copy-Item .env.example .env.local
#   macOS / Linux:        cp .env.example .env.local
#
# IMPORTANT: Put your private keys ONLY in .env.local (which is git-ignored).
# NEVER commit .env.local to GitHub!
# ==============================================================================

# Data Source Switch (set to 'supabase' to connect to live DB, or 'mock' for local in-memory fallback)
DATA_SOURCE="mock"

# Application Branding & Identity
NEXT_PUBLIC_APP_NAME="SBS CaseLab"
NEXT_PUBLIC_COLLEGE_NAME="Shanti Business School"
NEXT_PUBLIC_COLLEGE_SHORT="SBS"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAINS="shantibschool.edu.in"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN="shantibschool.edu.in"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="shantibschool.edu.in"

# Demo Mode & UI Flags (Enables 1-click Persona Switcher in Dev)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_AI_ENGINE_LABEL="AI Case Engine"

# Session Authentication Secret (Server Only - at least 32 characters)
SESSION_SECRET="change-this-to-a-secure-random-32-character-secret"

# ------------------------------------------------------------------------------
# Supabase Project Credentials
# Obtain from: https://supabase.com -> Project Settings -> API & Data API
# ------------------------------------------------------------------------------
# Project URL (public)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"

# Anon public key (safe for browser client)
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Service role key (CRITICAL: SERVER-ONLY, NEVER EXPOSE IN CLIENT OR GIT)
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# Optional: Anthropic Claude API Key (Server Only)
# Leave blank to use built-in simulated high-quality AI case engine
# ------------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# ------------------------------------------------------------------------------
# Razorpay Payment Gateway (Test Mode)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"
DEMO_PAYMENTS="false"
