# ==============================================================================
# SBS CaseLab - Environment Variables Configuration
# ==============================================================================
# Instructions for Teammate:
# 1. Copy this file to .env.local:
#    - Windows (Command Prompt): copy .env.example .env.local
#    - Windows (PowerShell):     Copy-Item .env.example .env.local
#    - macOS / Linux:            cp .env.example .env.local
# 2. You DO NOT need real API keys to run the app! SBS CaseLab includes an intelligent 
#    in-memory database and offline mock engine for zero-friction local development.
# ==============================================================================

# Application Branding & Identity
NEXT_PUBLIC_APP_NAME="SBS CaseLab"
NEXT_PUBLIC_COLLEGE_NAME="Shanti Business School"
NEXT_PUBLIC_COLLEGE_SHORT="SBS"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAINS="shantibschool.edu.in"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN="shantibschool.edu.in"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="shantibschool.edu.in"

# Demo Mode & UI Flags (Enables 1-click Persona Switcher in Dev)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_AI_ENGINE_LABEL="AI Case Engine"

# Session Authentication Secret (Server Only)
SESSION_SECRET="sbs_caselab_secure_session_secret_key_2026_dev"

# Supabase Credentials (Pre-configured offline mock fallback)
NEXT_PUBLIC_SUPABASE_URL="https://example-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.placeholder-service-key"

# Anthropic Claude API Key (Server Only - Optional)
# Leave blank to use the high-quality built-in simulated streaming AI engine
ANTHROPIC_API_KEY=""

# Razorpay Payment Gateway Credentials (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_51H8gAbcDef123"
RAZORPAY_KEY_SECRET="test_secret_key_placeholder_998877"
RAZORPAY_WEBHOOK_SECRET="test_webhook_secret_key"
