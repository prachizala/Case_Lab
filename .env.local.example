# ==============================================================================
# SBS CaseLab - Local Environment Configuration Template (.env.local.example)
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.local.example .env.local

# Application Branding & College Identity
NEXT_PUBLIC_APP_NAME="SBS CaseLab"
NEXT_PUBLIC_COLLEGE_NAME="Shanti Business School"
NEXT_PUBLIC_COLLEGE_SHORT="SBS"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAINS="shantibschool.edu.in"
NEXT_PUBLIC_COLLEGE_EMAIL_DOMAIN="shantibschool.edu.in"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN="shantibschool.edu.in"

# Demo Mode & UI Flags (Enables 1-click Persona Switcher in Dev)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"
NEXT_PUBLIC_AI_ENGINE_LABEL="AI Case Engine"

# Session Authentication Secret (Server Only - Minimum 32 characters)
SESSION_SECRET="change-this-to-a-secure-random-secret"

# Supabase Credentials (Pre-configured offline mock fallback)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# Anthropic Claude API Key (Server Only - Optional)
# Leave blank to use the high-quality built-in simulated streaming AI engine
ANTHROPIC_API_KEY=""

# Razorpay Payment Gateway Credentials (Test Mode)
NEXT_PUBLIC_RAZORPAY_KEY_ID="rzp_test_placeholder"
RAZORPAY_KEY_SECRET="razorpay_secret_placeholder"
RAZORPAY_WEBHOOK_SECRET="razorpay_webhook_secret_placeholder"
DEMO_PAYMENTS="false"
